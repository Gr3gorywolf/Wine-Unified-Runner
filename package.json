{
    "name": "wur",
    "version": "0.1.0",
    "description": "WUR — Wine Unified Runner: portable Wine environments and Windows game launches",
    "license": "GPL-3.0-only",
    "type": "module",
    "bin": {
        "wur": "dist/src/cli.js"
    },
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
        "build-binary": "node scripts/build-binary.mjs",
        "check": "npm run format:check && tsc --noEmit -p tsconfig.json",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "test": "npm run build && node --test dist/test/*.test.js",
        "start": "node --enable-source-maps dist/src/cli.js"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.4",
        "@types/lodash": "^4.17.27",
        "@types/node": "^18.19.130",
        "esbuild": "^0.28.2",
        "postject": "1.0.0-alpha.6",
        "typescript": "^5.7.3"
    },
    "dependencies": {
        "axios": "^1.21.0",
        "commander": "^12.1.0",
        "jsonc-parser": "^3.3.1",
        "lodash": "^4.18.1",
        "picocolors": "^1.1.1",
        "zod": "^4.6.7"
    }
}
