{
  "name": "proton-cli-launch",
  "version": "0.1.0",
  "description": "CLI for managing Heroic-compatible Proton/Wine runtimes, prefixes, and Windows game launches",
  "license": "GPL-3.0-only",
  "type": "module",
  "bin": {
    "proton-cli": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node --enable-source-maps dist/src/cli.js"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^5.7.3"
  }
}
